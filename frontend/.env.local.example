# Public devnet RPC rate-limits hard once more than a few wallets are active.
# Point this at a Helius/QuickNode devnet endpoint for a smoother demo.
NEXT_PUBLIC_DEVNET_RPC=https://api.devnet.solana.com

# MagicBlock TEE ephemeral rollup. Private accounts only exist here.
NEXT_PUBLIC_TEE_RPC=https://devnet-tee.magicblock.app
